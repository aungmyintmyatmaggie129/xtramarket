    <!--    Location Form Section-->
    <div class="w-full py-10 lg:h-200 flex justify-center items-center px-4 sm:px-6">
        <div class="relative w-full max-w-7xl flex flex-col lg:flex-row justify-between items-center gap-10 lg:gap-2">

            <!--    Location input Form-->
            <div class="w-full lg:w-4xl bg-[#122E40] rounded-4xl flex flex-col justify-center items-center py-10 px-4 sm:px-8">
                <div class="w-full max-w-3xl flex flex-col justify-center items-center gap-2">
                    <div class="w-full flex flex-wrap justify-start items-center gap-2 mb-4">
                        <div class="relative inline-block">
                            <h2 class="text-[#00E281] text-3xl sm:text-5xl font-bold z-2">Get in touch</h2>
