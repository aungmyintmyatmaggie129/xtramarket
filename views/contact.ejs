                        <div class="w-full flex justify-center items-center py-4">
                            <div class="w-full">
                                <div class="w-full flex flex-col justify-center items-start gap-2">
                                    <label for="question" class="text-[#A1ABB3] text-base sm:text-lg">Your Question</label>
                                    <textarea name="question" id="question" class="w-full h-[180px] sm:h-[200px] px-4 py-3 bg-[#FFFFFF] rounded-3xl outline-none border-none resize-none"></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Send Button Section-->
                        <div class="w-full flex justify-start items-center gap-4 py-4">
