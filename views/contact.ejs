                                    <input type="text" id="userEmail" class="w-full h-12 sm:h-13 px-4 bg-[#FFFFFF] rounded-3xl outline-none border-none" required>
                                </div>
                                <div class="w-full flex flex-col justify-center items-start gap-2">
                                    <label for="department" class="text-[#A1ABB3] text-base sm:text-lg">Department</label>
                                    <input type="text" id="department" class="w-full h-12 sm:h-13 px-4 bg-[#FFFFFF] rounded-3xl outline-none border-none" required>
