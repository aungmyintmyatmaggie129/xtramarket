        </div>
        <!-- All Fruit Products - spans 2 cols on large -->
        <div class="relative bg-[#122D40] rounded-3xl overflow-hidden h-52 sm:h-64 lg:col-span-2">
            <img class="absolute w-48 sm:w-64 h-auto right-0 bottom-0" src="./image/bg-banana-3.png" alt="banana">
            <div class="relative p-2 md:p-8 text-white">
                <h2 class="text-3xl font-thin mb-3">50% OFF</h2>
                <p class="text-3xl sm:text-4xl font-bold mb-2">Sale 58% Off</p>
                <p class="text-2xl sm:text-3xl font-bold mb-6">All Fruit Products</p>
                <a class="px-6 py-3 uppercase text-sm font-bold bg-[#354B5C] rounded-full transition duration-300 hover:text-[#122E40] hover:bg-[#00E281] inline-block"
                    href="/newproduct">Shop now <i class="fa-solid fa-arrow-right ml-2"></i></a>
            </div>
        </div>
    </div>
</div>

