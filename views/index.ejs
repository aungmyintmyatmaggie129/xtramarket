<!--    Latest News & Blog-->
<div class="w-full flex justify-center items-center px-4 sm:px-8 py-10">
    <div class="w-full max-w-6xl flex flex-col gap-6">
        <!-- Header -->
        <div class="w-full flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex justify-center items-center gap-2">
                <h2 class="text-black text-3xl sm:text-4xl font-bold">Latest</h2>
                <span class="relative inline-block">
                    <span class="text-[#00E281] text-3xl sm:text-4xl font-bold z-2">News & Blog</span>
                    <span class="absolute w-full h-3 bg-green-100 rounded-md left-0 bottom-0 -z-10"></span>
                </span>
            </div>
            <div class="flex justify-center items-center gap-2">
                <button id="moveLeft"
                    class="px-8 py-3 bg-[#bbb] rounded-tl-3xl rounded-br-3xl hover:bg-[#888] transition-all duration-300">
                    <i class="fa-solid fa-angle-left"></i>
                </button>
                <button id="moveRight"
                    class="px-8 py-3 bg-[#bbb] rounded-tr-3xl rounded-bl-3xl hover:bg-[#888] transition-all duration-300">
                    <i class="fa-solid fa-angle-right"></i>
                </button>
            </div>
        </div>
        <!-- Blog Cards Slider -->
        <div class="w-full overflow-x-auto no-scrollbar">
            <div id="slider" class="flex flex-nowrap gap-4 px-1 py-4">
                <% const blogPosts=[ { tag: 'Tutorial' , img: './image/p10.jpg' , date: '10 June 2024' ,
                    title: 'March retail scales, foot traffic take a dip' }, { tag: 'Interview' , img: './image/p9.jpg'
                    , date: '10 June 2024' , title: 'Kroger ready to expand technology reach' }, { tag: 'News' ,
                    img: './image/p8.jpg' , date: '10 June 2024' ,
                    title: "Coborn's to acquire Sullivan's Foods in Illinois" }, { tag: 'Updates' ,
                    img: './image/p7.jpg' , date: '10 June 2024' , title: 'Whole Foods announces layoffs, restructuring'
                    }, { tag: 'News' , img: './image/p5.jpg' , date: '10 June 2024' ,
                    title: 'Walmart adds first-of-its-kind truck to fleet' }, { tag: 'Tutorial' , img: './image/p6.jpg'
                    , date: '10 June 2024' , title: 'Metro sales were on the rise in Q2' } ]; %>

                    <!-- For Each with card -->

                    <% blogPosts.forEach(post=> { %>

                        <div
                            class="group flex-shrink-0 w-64 sm:w-72 rounded-2xl flex flex-col justify-between items-center">
                            <div class="relative w-full flex justify-center">
                                <a class="relative z-10 px-4 py-1.5 font-medium text-xs text-white bg-[#112D3F] border-4 border-white rounded-full transition-all duration-300 hover:text-[#112D3F] hover:bg-[#00E281]"
                                    href="#">
                                    <%= post.tag %>
                                </a>
                            </div>
                            <div class="relative w-full h-52 rounded-2xl overflow-hidden mt-3">
                                <img class="absolute w-full h-full object-cover group-hover:scale-110 transition-all duration-300"
                                    src="<%= post.img %>" alt="blog">
                            </div>
                            <div class="w-full pt-4 flex flex-col gap-2">
                                <h2 class="text-[#00E281] text-sm">
                                    <%= post.date %>
                                </h2>
                                <hr class="text-[#E6E7EA]">
                                <p class="text-2xl font-light">
                                    <%= post.title %>
                                </p>
                            </div>
                        </div>
                        <% }); %>
            </div>
        </div>
    </div>
</div>