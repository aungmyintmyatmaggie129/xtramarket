<!--    Products Grid -->
<div class="w-full bg-white flex justify-center items-center px-4 sm:px-8 py-10">
    <div class="w-full max-w-6xl grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">

        <% cardData.forEach(item=> { %>
            <form action="/cart/addToCart" method="post">
                <div
                    class="group bg-[#FEFEFE] rounded-tl-3xl rounded-br-3xl shadow-md flex flex-col justify-between items-center cursor-pointer relative">
                    <div class="w-full flex flex-col justify-around items-start pt-4 pb-2">
                        <!-- Product Image -->
                        <div class="overflow-hidden ml-4 text-center flex justify-center items-center">
                            <img class="md:w-60 sm:w-60 transition-transform group-hover:scale-110 duration-300"
                                src=<%=item.img %> alt="product">
                            <input type="hidden" name="img" value=<%=item.img %>>
                        </div>
                        <!-- Product Name -->
                        <div class="ml-6 mt-3 capitalize group-hover:text-[#00E281] transition-all duration-300">
                            <div class="flex flex-row md:flex-col justify-center items-start gap-2">
                                <h3 class="text-2xl md:text-lg sm:text-xl font-bold ">
                                    <%= item.productName %>
                                </h3>
                                <input type="hidden" name="productFullName" value=<%=item.productFullName %>>
                                <h3 class="text-2xl md:text-lg sm:text-xl font-bold">
                                    <%= item.productSecondName %>
                                </h3>
                            </div>
                            <span
                                class="font-thin text-sm text-[#364C5D] group-hover:text-[#00E281] transition-all duration-300">
                                <%= item.productType %>
                            </span>
                        </div>
                        <!-- Stars + Price -->
                        <div class="ml-6 mt-2 flex items-center gap-2">
                            <div>
                                <i class="fa-solid fa-star text-[#FFBB00] text-sm"></i>
                                <i class="fa-solid fa-star text-[#FFBB00] text-sm"></i>
                                <i class="fa-solid fa-star text-[#FFBB00] text-sm"></i>
                                <i class="fa-solid fa-star text-[#FFBB00] text-sm"></i>
                                <i class="fa-solid fa-star text-[#FFBB00] text-sm"></i>
                            </div>
                            <span class="text-lg font-medium">$<%= item.price %></span>
                            <input type="hidden" name="price" value=<%=item.price %>>
                        </div>
                    </div>

                    <!-- Float Action Buttons -->
                    <div class="absolute top-4 right-4 hidden lg:flex flex-col items-end gap-2">
                        <!-- Wishlist -->
                        <div class="group/wish flex justify-end items-center gap-2">
                            <span
                                class="hidden scale-0 px-2 py-1 bg-[#00E281] rounded-full text-xs transition-all duration-200 group-hover/wish:flex group-hover/wish:scale-100 group-hover/wish:text-black whitespace-nowrap">
                                Add to wishlist
                            </span>
                            <button type="button"
                                class="px-2.5 py-2 border border-[#DDDDDD] rounded-full transition-all duration-300 hover:text-[#00E2A1] hover:border-[#00E2A1] text-sm bg-white">
                                <i class="fa-regular fa-heart"></i>
                            </button>
                        </div>
                        <!-- Compare -->
                        <div class="group/compare flex justify-end items-center gap-2">
                            <span
                                class="opacity-0 px-2 py-1 bg-[#00E281] rounded-full text-xs transition-all duration-200 group-hover/compare:opacity-100 group-hover/compare:text-black whitespace-nowrap">
                                Add to compare
                            </span>
                            <button type="button"
                                class="px-2.5 py-2 border border-[#DDDDDD] rounded-full transition-all duration-300 hover:text-[#00E2A1] hover:border-[#00E2A1] text-sm bg-white">
                                <i class="fa-solid fa-arrow-right-arrow-left"></i>
                            </button>
                        </div>
                        <!-- Quick View -->
                        <div class="openPopupBtn group/view flex justify-end items-center gap-2">
                            <span
                                class="opacity-0 px-2 py-1 bg-[#00E281] rounded-full text-xs transition-all duration-200 group-hover/view:opacity-100 group-hover/view:text-black whitespace-nowrap">
                                Quick view
                            </span>
                            <button type="button"
                                class="px-2.5 py-2 border border-[#DDDDDD] bg-transparent rounded-full transition-all duration-300 hover:text-[#00E2A1] hover:border-[#00E2A1] text-sm bg-white">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </button>
                        </div>
                    </div>
                    <!-- Quick View Popup -->
                    <div class="popup">
                        <div class="popup-box">
                            <div class="popupBtn-container">
                                <button type="button" class="closePopupBtn"><i class="fa-solid fa-xmark"></i></button>
                            </div>
                            <div class="popup-container">
                                <img src=<%=item.img %> alt="" class="src">
                                <div class="content">
                                    <div class="mt-10 flex flex-col justify-center items-start gap-2">
                                        <h2 class="text-2xl sm:text-4xl font-bold capitalize">
                                            <%= item.productName %>
                                                <%= item.productSecondName %>
                                        </h2>
                                        <a href="#" class="text-sm">View full product details <i
                                                class="fa-solid fa-arrow-right"></i></a>
                                        <!-- Rating -->
                                        <div class="flex justify-center items-center gap-1">
                                            <span class="px-1.5 border border-[#F1F2F6] rounded-md text-sm">5.0</span>
                                            <div class="select-none">
                                                <i class="fa-solid fa-star text-[#FFBB00] text-sm"></i>
                                                <i class="fa-solid fa-star text-[#FFBB00] text-sm"></i>
                                                <i class="fa-solid fa-star text-[#FFBB00] text-sm"></i>
                                                <i class="fa-solid fa-star text-[#FFBB00] text-sm"></i>
                                                <i class="fa-solid fa-star text-[#FFBB00] text-sm"></i>
                                            </div>
                                            <span class="text-sm">(5 Rating)</span>
                                        </div>
                                        <!-- Price & Purchase -->
                                        <div class="flex flex-col justify-center items-start gap-4 w-full">
                                            <h2 class="text-2xl sm:text-3xl font-bold text-[#00E281]">$<%= item.price %>
                                            </h2>
                                            <p class="max-h-[100px] overflow-hidden text-sm">Pellentesque habitant morbi
                                                tristique senectus et netus et malesuada fames ac turpis egestas.
                                                Vestibulum tortor quam, feugiat vitae, ultricies eget, tempor sit amet,
                                                ante.</p>
                                            <!-- Counter + Add to Cart -->
                                            <div
                                                class="w-full flex flex-col sm:flex-row justify-around items-center gap-3">
                                                <div class="flex justify-around items-center gap-2">
                                                    <button type="button"
                                                        class="btn-minus px-3 py-2.5 text-[#00E281] bg-[#F6F6F6] rounded-full transition-all duration-300 hover:text-[#122E40] hover:bg-[#00E281]">
                                                        <i class="fa-solid fa-minus text-sm"></i>
                                                    </button>
                                                    <input type="text" min="1" max="99" name="qty" value="1"
                                                        class="product w-20 h-9 text-center text-base font-bold outline-none border border-[#7F7F7F] rounded-full transition-all duration-300 focus:border-[#00E281]">
                                                    <button type="button"
                                                        class="btn-plus px-3 py-2.5 text-[#00E281] bg-[#F6F6F6] rounded-full transition-all duration-300 hover:text-[#122E40] hover:bg-[#00E281]">
                                                        <i class="fa-solid fa-plus text-sm"></i>
                                                    </button>
                                                </div>
                                                <button type="submit"
                                                    class="w-full sm:w-auto px-6 py-2.5 text-sm font-bold bg-[#00E281] rounded-full transition duration-300 hover:text-[#00E281] hover:bg-[#122E40]">
                                                    <i class="fa-solid fa-cart-shopping mr-1"></i> Add to cart
                                                </button>
                                            </div>
                                            <!-- People added -->
                                            <span
                                                class="w-full py-3 text-[#777777] bg-[#F6F6F6] text-center rounded-2xl text-sm">
                                                <i class="fa-solid fa-cart-shopping"></i> <strong>1000</strong> people
                                                have added this product to their cart
                                            </span>
                                            <!-- Speak to specialist -->
                                            <a href="javascript:void(0)"
                                                class="group/phone w-full bg-[#F6F6F6] border-2 border-[#F4F4F4] rounded-2xl flex justify-start items-center gap-4 py-4 px-4 transition-all duration-300 hover:border-[#00E281]">
                                                <i class="fa-solid fa-square-phone text-5xl text-[#00E281]"></i>
                                                <div class="flex flex-col justify-center items-start">
                                                    <p
                                                        class="text-xs text-[#C2C2C2] transition-all duration-300 group-hover/phone:text-[#00E281]">
                                                        Need help choosing the right product?</p>
                                                    <p
                                                        class="text-sm font-bold text-[#6A6A6A] transition-all duration-300 group-hover/phone:text-[#00E281]">
                                                        Speak to product specialist at 1-312-800-000</p>
                                                </div>
                                            </a>
                                            <hr class="w-full text-[#C2C2C2]">
                                            <!-- Product Details Table -->
                                            <div
                                                class="w-full flex flex-col sm:flex-row justify-around items-start sm:items-center gap-4">
                                                <table class="product-table text-sm">
                                                    <tr>
                                                        <td>Brand</td>
                                                        <td>Your Brand Name</td>
                                                    </tr>
                                                    <tr>
                                                        <td>SKU</td>
                                                        <td>SKU_19**</td>
                                                    </tr>
                                                    <tr>
                                                        <td>Status</td>
                                                        <td>99 in stock</td>
                                                    </tr>
                                                    <tr>
                                                        <td>Tags</td>
                                                        <td class="capitalize">
                                                            <%= item.productFullName.replaceAll("_", " " ) %>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>Categories</td>
                                                        <td>
                                                            <%= item.productType %>
                                                        </td>
                                                    </tr>
                                                </table>
                                                <img src="./image/brand-xtra-2.jpg" alt="xtratheme"
                                                    class="w-24 h-12 object-contain">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Add to Cart Button (hover) -->
                    <div class="relative w-full h-10 flex justify-center items-center transition-all duration-300 mb-2">
                        <button type="submit"
                            class="absolute px-5 py-2.5 text-sm font-bold bg-[#00E281] rounded-full -bottom-5 transition duration-300 lg:opacity-0 group-hover:opacity-100 hover:text-[#00E281] hover:bg-[#122E40] whitespace-nowrap"><i
                                class="fa-solid fa-cart-shopping mr-1"></i> Add to cart</button>
                    </div>
                </div>
            </form>
            <% }); %>
    </div>
</div>

<!--    Downloadable App Section-->
<div class="w-full flex justify-center items-center px-4 sm:px-8 py-10">
    <div
        class="w-full max-w-6xl bg-[url(./image/box-bg.jpg)] bg-cover bg-center rounded-3xl flex flex-col lg:flex-row justify-around items-center gap-8 px-6 sm:px-10 py-10 lg:py-0 lg:min-h-[400px]">
        <div
            class="w-full max-w-md text-white flex flex-col justify-center items-start gap-5 text-center lg:text-left items-center lg:items-start">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-thin">XtraSupermarket</h1>
