        <!-- Full Fresh Vegetable - spans rows on large screens -->
        <div class="relative bg-[#01E281] rounded-3xl overflow-hidden h-52 sm:h-64 lg:row-span-2 lg:h-auto">
            <img class="absolute right-0 bottom-0 w-auto h-2/3 lg:h-auto" src="./image/bg-busket-4.png" alt="basket">
            <div class="relative p-2 md:p-8 text-white">
                <h2 class="text-3xl font-thin mb-3">50% OFF</h2>
                <p class="text-3xl sm:text-4xl font-bold mb-2">Full Fresh</p>
                <p class="text-3xl sm:text-4xl font-bold mb-6">Vegetable</p>
