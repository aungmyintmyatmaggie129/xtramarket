<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="./css/quickview.css">
    <link rel="stylesheet" href="./css/hamburger.css">
    <title>
        <%= title %>
    </title>
    <style>
        * {
            scroll-behavior: smooth;
        }

        *::-webkit-scrollbar {
            font-family: sans-serif;
            display: none;
            background-color: #fcfdfd5e;
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            scrollbar-width: none;
        }
    </style>
</head>

<body>

    <!-- ===== TOP ANNOUNCEMENT BAR ===== -->
    <header class="w-full h-[50px] bg-[#262626] flex justify-center items-center fixed z-50 top-0">
        <div class="progressbar fixed w-0 h-[50px] bg-[#8282829c]"></div>
        <div class="flex justify-between items-center w-full max-w-7xl">
            <div class="text-white flex items-center gap-1">
                <p class="text-base font-bold">xtra</p>
                <p class="text-base hidden sm:block">market</p>
            </div>
            <div class="text-white text-xs sm:text-sm text-center hidden sm:block">
                <p>Want to become a seller? Please contact us right now.</p>
            </div>
            <div class="w-20 hidden sm:block"></div>
        </div>
    </header>

    <!-- ===== MAIN HEADER: LOGO + SEARCH + ICONS ===== -->
    <section
        class="w-full bg-[#122E40] flex flex-col sm:flex-row justify-between items-center px-4 sm:px-8 py-8 gap-4 mt-[30px]">

        <!-- Logo -->
        <div class="flex justify-center sm:justify-start">
            <a href="/index">
                <img class="w-40 sm:w-52 h-auto" src="./image/logo-sm.png" alt="Logo">
            </a>
        </div>

        <!-- Search Bar -->
        <div class="w-full sm:w-auto flex-1 max-w-md mx-0 sm:mx-0">
            <div class="w-full h-12 text-white bg-[#364C5D] rounded-full flex justify-between items-center">
                <input
                    class="w-full h-full px-5 bg-transparent border-none outline-none text-sm rounded-l-full placeholder-gray-400"
                    type="text" placeholder="What are you looking for?">
                <i
                    class="fa-solid fa-magnifying-glass p-3 mr-1 bg-[#122E40] rounded-full text-sm cursor-pointer hover:text-[#00E281] transition-all duration-300"></i>
            </div>
        </div>

        <!-- Icons: Phone + Cart + Wish + User -->
        <div class="flex items-center gap-3">
            <!-- Call Center (hidden on mobile) -->
            <div class="hidden md:flex items-center gap-2">
                <button>
                    <i
                        class="fa-solid fa-phone p-3 border border-white rounded-full text-white text-sm transition duration-300 hover:border-[#00E281] hover:text-[#00E281]"></i>
                </button>
                <div class="cursor-pointer">
                    <h2 class="text-xs font-bold text-[#9FB7CB]">Call Center</h2>
                    <p class="text-xs font-bold text-white">959-683 972 901</p>
                </div>
            </div>

            <!-- Cart -->
            <a href="/cart">
                <i
                    class="fa-solid fa-basket-shopping p-3 border border-white rounded-full text-white text-sm transition duration-300 hover:border-[#00E281] hover:text-[#00E281]"></i>
            </a>
            <!-- Wishlist -->
            <button>
                <i
                    class="fa-regular fa-heart p-3 border border-white rounded-full text-white text-sm transition duration-300 hover:border-[#00E281] hover:text-[#00E281]"></i>
            </button>
            <!-- Profile -->
            <button>
                <i
                    class="fa-regular fa-user p-3 border border-white rounded-full text-white text-sm transition duration-300 hover:border-[#00E281] hover:text-[#00E281]"></i>
            </button>

            <!-- Hamburger (mobile only) -->
            <button id="hamburger-btn"
                class="md:hidden p-3 border border-white rounded-full text-white text-sm transition duration-300 hover:border-[#00E281] hover:text-[#00E281]">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>
    </section>

    <!-- ===== DESKTOP NAVBAR ===== -->
    <section class="hidden md:flex w-full bg-[#1D3E56] justify-center items-center py-3 sticky top-[50px] z-40">
        <nav class="w-full max-w-7xl flex justify-between items-center px-8">
            <ul
                class="flex justify-around items-center list-none text-white text-sm lg:text-base cursor-pointer gap-4 lg:gap-6 flex-wrap">
                <a href="/newproduct">
                    <li class="hover:text-[#00E281] transition-all duration-200 whitespace-nowrap">
                        <i class="fa-solid fa-cart-shopping mr-1"></i>New Products
                    </li>
                </a>
                <li class="hover:text-[#00E281] transition-all duration-200 whitespace-nowrap">
                    Best Sales <i class="fa-solid fa-fire text-[#FF4D3B] ml-1"></i>
                </li>
                <li class="relative group hover:text-[#00E281] transition-all duration-200 whitespace-nowrap">
                    <div>
                        <i class="fa-solid fa-percent mr-1"></i> Special Offers
                        <i
                            class="fa-solid fa-caret-right transition-transform duration-200 group-hover:rotate-90 ml-1"></i>
                    </div>
                    <!-- Drop down -->
                    <div class="absolute -left-70 top-8 w-320
                    opacity-0 invisible translate-y-3
                    group-hover:opacity-100
                    group-hover:visible
                    group-hover:translate-y-0
                    transition-all duration-300
                    bg-[#122E40] rounded-xl shadow-2xl/90
                    p-8 z-50">
                        <div class="flex justify-center items-center gap-5">
                            <!-- Card Datas -->
                            <% const cards=[ {img: './image/s1-fish.png' , title: 'fishes & raw meats' , priceOffer:
                                20}, {img: './image/s2-fruit.png' , title: 'fruits & vegetables' , priceOffer: 15},
                                {img: './image/s3-bread.png' , title: 'breads & sweats' , priceOffer: 50},
                                {img: './image/s4-cheese.png' , title: 'milk & proteins' , priceOffer: 45},
                                {img: './image/s6-readymade.png' , title: 'ready touse foods' , priceOffer: 40}, ]; %>
                                <!-- For each with cards -->
                                <% cards.forEach(card=> { %>
                                    <div
                                        class="group/card cursor-pointer p-7 px-10 border-1 border-[#144449] rounded-3xl flex flex-col justify-center items-center gap-3 transition-all duration-300 hover:border-[#00E281]">
                                        <img src=<%=card.img %>
                                        class="rounded-lg h-20 w-22 object-cover group-hover/card:scale-105 transition">
                                        <h3 class="mt-3 font-semibold text-white capitalize">
                                            <%= card.title %>
                                        </h3>
                                        <p class="text-sm text-white">
                                            Crystal clear sound
                                        </p>
                                        <p class="mt-2 font-thin text-[#00E281]">
                                            <%= card.priceOffer %>% OFF
                                        </p>
                                    </div>
                                    <% }); %>
                        </div>
                    </div>
                </li>
                <li class="group hover:text-[#00E281] transition-all duration-200 whitespace-nowrap">
                    <div>
                        Quick find
                        <i
                            class="fa-solid fa-caret-right transition-transform duration-200 group-hover:rotate-90 ml-1"></i>
                    </div>
                    <div class="absolute left-100 top-13 w-120
                    opacity-0 invisible translate-y-3
                    group-hover:opacity-100
                    group-hover:visible
                    group-hover:translate-y-0
                    transition-all duration-300
                    bg-[#122E40] rounded-xl shadow-2xl/90
                    p-8 z-50">
                        <div class="flex justify-center items-center gap-5">
                            <% %>

                                <% for (const [key,value] of Object.entries(quickviewData)) { %>
                                    <% const currentIcon=iconData[key] %>
                                        <div
                                            class="group/card cursor-pointer p-2 flex flex-col justify-center items-start gap-3 transition-all duration-300">
                                            <h4 class="font-bold capitalize">
                                                <%= key %>
                                            </h4>
                                            <% value.forEach(item=> { %>
                                                <span
                                                    class="group/icon text-white font-thin capitalize font-medium transition-all duration-300 hover:text-[#00E281]">
                                                    <i
                                                        class="fa-solid <%= currentIcon %> text-[#5a6c7a] mr-1 transition-all duration-300 group-hover/icon:text-[#00E281]"></i>
                                                    <%= item %>
                                                </span>
                                                <% }); %>
                                        </div>
                                        <% } %>
                        </div>
                    </div>
                </li>
                <a href="/blog">
                    <li class="hover:text-[#00E281] transition-all duration-200">News</li>
                </a>
                <a href="/contact">
                    <li class="hover:text-[#00E281] transition-all duration-200">Contact</li>
                </a>
            </ul>
            <a href="#"
                class="px-5 py-2.5 bg-[#00E281] rounded-full text-sm font-bold transition duration-300 hover:text-[#00E281] hover:bg-[#122E40] whitespace-nowrap ml-4">
                <i class="fa-solid fa-gift mr-1"></i> Daily Offers
            </a>
        </nav>
    </section>

    <!-- ===== MOBILE MENU ===== -->
    <div id="mobile-menu" class="absolute md:hidden w-full h-full bg-[#000]/30 flex flex-row items-start z-60">
        <div class="flex justify-center items-center">
            <button id="cancelBtn" type="button" class="w-20 h-20 "><i
                    class="fa-solid fa-x text-2xl text-white"></i></button>
        </div>
        <div class="w-full h-full pl-4 bg-[#122E40] flex flex-col justify-start items-center">
            <a href="/newproduct"
                class="text-white hover:text-[#00E281] transition-all duration-200 py-2 border-b border-[#2F485C] w-full block">
                <i class="fa-solid fa-cart-shopping mr-2"></i>New Products
            </a>
            <a href="#"
                class="text-white hover:text-[#00E281] transition-all duration-200 py-2 border-b border-[#2F485C] w-full block">
                Best Sales <i class="fa-solid fa-fire text-[#FF4D3B] ml-1"></i>
            </a>
            <a href="#"
                class="text-white hover:text-[#00E281] transition-all duration-200 py-2 border-b border-[#2F485C] w-full block">
                <i class="fa-solid fa-percent mr-1"></i> Special Offers
            </a>
            <a href="#"
                class="text-white hover:text-[#00E281] transition-all duration-200 py-2 border-b border-[#2F485C] w-full block">
                Quick find
            </a>
            <a href="/blog"
                class="text-white hover:text-[#00E281] transition-all duration-200 py-2 border-b border-[#2F485C] w-full block">News</a>
            <a href="/contact"
                class="text-white hover:text-[#00E281] transition-all duration-200 py-2 border-b border-[#2F485C] w-full block">Contact</a>
            <a href="#"
                class="mt-2 px-6 py-2.5 bg-[#00E281] rounded-full text-sm font-bold text-[#122E40] transition duration-300 hover:bg-[#FFFFFF] inline-block">
                <i class="fa-solid fa-gift mr-1"></i> Daily Offers
            </a>
        </div>
    </div>

    <!-- ===== PAGE CONTENT ===== -->
    <%- body %>

        <!-- ===== SUBSCRIBE BAR SPACER ===== -->
        <div class="w-full h-20 sm:h-32 lg:h-40"></div>

        <!-- ===== SUBSCRIBE SECTION ===== -->
        <div class="w-full flex justify-center items-center px-4 sm:px-8 mb-[-40px] relative z-10">
            <div
                class="w-full max-w-6xl bg-[url(./image/bg-subscribe.jpg)] bg-cover bg-center rounded-3xl flex flex-col sm:flex-row justify-evenly items-center gap-6 px-6 sm:px-10 py-8">
                <div class="flex flex-col sm:flex-row items-center gap-2 text-center sm:text-left">
                    <h2 class="text-2xl sm:text-3xl lg:text-4xl text-white font-bold">Subscribe to</h2>
                    <h2 class="text-2xl sm:text-3xl lg:text-4xl text-[#00E281] font-bold">Newsletter</h2>
                </div>
                <div class="w-full sm:w-auto flex items-center bg-white rounded-full overflow-hidden max-w-sm">
                    <input class="flex-1 h-12 px-5 border-none outline-none text-[#122E40] text-sm bg-transparent"
                        type="text" placeholder="Enter Your Email...">
                    <a class="px-5 py-3 text-sm font-bold text-[#122E40] bg-[#00E281] rounded-full cursor-pointer transition duration-300 hover:text-[#00E281] hover:bg-[#122E40] whitespace-nowrap m-1"
                        href="#"><i class="fa-solid fa-envelope-open mr-1"></i> Subscribe</a>
                </div>
            </div>
        </div>

        <!-- ===== FOOTER ===== -->
        <footer class="w-full bg-[#122E40] rounded-t-3xl pt-24 pb-0">

            <!-- Footer Cards -->
            <div
                class="w-full max-w-7xl mx-auto px-4 sm:px-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 py-10">

                <!-- Brand Info -->
                <div class="border border-[#2F485C] rounded-3xl p-6 flex flex-col gap-6">
                    <img class="w-36" src="./image/logo-sm.png" alt="Logo">
                    <span class="text-white leading-8 text-sm">
                        "Be who you are and say what you feel, because those who mind don't matter, and those who matter
                        don't mind."
                    </span>
                    <div class="flex gap-3">
                        <a class="px-3 py-2.5 bg-[#204560] rounded-full transition-all duration-300 hover:bg-[#3C5998] text-white text-sm"
                            href="https://www.facebook.com/">
                            <i class="fa-brands fa-facebook"></i>
                        </a>
                        <a class="px-3 py-2.5 bg-[#204560] rounded-full transition-all duration-300 hover:bg-[#1DA1F2] text-white text-sm"
                            href="https://www.facebook.com/">
                            <i class="fa-brands fa-x-twitter"></i>
                        </a>
                        <a class="px-3 py-2.5 bg-[#204560] rounded-full transition-all duration-300 hover:bg-[#CC467D] text-white text-sm"
                            href="https://www.instagram.com/">
                            <i class="fa-brands fa-instagram"></i>
                        </a>
                    </div>
                </div>

                <!-- Useful Links -->
                <div class="border border-[#2F485C] rounded-3xl p-6 flex flex-col gap-3">
                    <h2 class="text-white text-lg font-bold pb-3 mb-1 border-b border-[#2F485C] capitalize">Useful Links
                    </h2>
                    <a class="group text-white text-sm transition-all hover:translate-x-2 hover:text-[#00E281] flex items-center gap-2"
                        href="#">
                        <i
                            class="fa-solid fa-link px-1.5 py-1.5 text-[#00E281] bg-[#17524E] rounded-full transition-all duration-300 group-hover:text-[#122E40] group-hover:bg-[#00E281] text-xs"></i>
                        Help Center
                    </a>
                    <a class="group text-white text-sm transition-all hover:translate-x-2 hover:text-[#00E281] flex items-center gap-2"
                        href="#">
                        <i
                            class="fa-solid fa-link px-1.5 py-1.5 text-[#00E281] bg-[#17524E] rounded-full transition-all duration-300 group-hover:text-[#122E40] group-hover:bg-[#00E281] text-xs"></i>
                        Terms & Conditions
                    </a>
                    <a class="group text-white text-sm transition-all hover:translate-x-2 hover:text-[#00E281] flex items-center gap-2"
                        href="#">
                        <i
                            class="fa-solid fa-link px-1.5 py-1.5 text-[#00E281] bg-[#17524E] rounded-full transition-all duration-300 group-hover:text-[#122E40] group-hover:bg-[#00E281] text-xs"></i>
                        Privacy Policy
                    </a>
                    <a class="group text-white text-sm transition-all hover:translate-x-2 hover:text-[#00E281] flex items-center gap-2"
                        href="#">
                        <i
                            class="fa-solid fa-link px-1.5 py-1.5 text-[#00E281] bg-[#17524E] rounded-full transition-all duration-300 group-hover:text-[#122E40] group-hover:bg-[#00E281] text-xs"></i>
                        Refund Policy
                    </a>
                    <a class="group text-white text-sm transition-all hover:translate-x-2 hover:text-[#00E281] flex items-center gap-2"
                        href="#">
                        <i
                            class="fa-solid fa-phone-flip px-1.5 py-1.5 text-[#00E281] bg-[#17524E] rounded-full transition-all duration-300 group-hover:text-[#122E40] group-hover:bg-[#00E281] text-xs"></i>
                        +959 683 972 901
                    </a>
                    <a class="group text-white text-sm transition-all hover:translate-x-2 hover:text-[#00E281] flex items-center gap-2"
                        href="#">
                        <i
                            class="fa-solid fa-envelope-open px-1.5 py-1.5 text-[#00E281] bg-[#17524E] rounded-full transition-all duration-300 group-hover:text-[#122E40] group-hover:bg-[#00E281] text-xs"></i>
                        info@example.com
                    </a>
                </div>

                <!-- Become a Seller -->
                <div class="border border-[#2F485C] rounded-3xl p-6 flex flex-col gap-6 sm:col-span-2 lg:col-span-1">
                    <div>
                        <h2 class="text-xl font-bold text-white">Interested in a Great Way</h2>
                        <h2 class="text-xl font-bold text-[#00E281]">Make Money?</h2>
                    </div>
                    <p class="text-[#ACACAC] text-sm leading-7">
                        A supermarket is a self-service shop offering a wide variety of food, beverages and household
                        products.
                    </p>
                    <a class="px-6 py-3 capitalize text-sm font-bold text-[#122E40] bg-[#00E281] rounded-full cursor-pointer transition duration-300 hover:bg-white self-start"
                        href="#">Become a Seller</a>
                </div>
            </div>

            <!-- Footer Bottom Bar -->
            <div
                class="w-full border-t border-[#2F485C] flex flex-col sm:flex-row justify-between items-center gap-3 px-6 sm:px-10 py-5">
                <p class="text-[#C9CCCE] text-xs sm:text-sm font-thin text-center sm:text-left">
                    With <i class="fa-solid fa-heart text-red-400"></i> by Maggie. Copyright © 2026 Maggie.
                </p>
                <img class="h-8" src="./image/cards-ads.png" alt="Payment methods">
            </div>
        </footer>


</body>
<script src="/js/quickview.js"></script>
<script src="/js/slide.js"></script>
<script src="/js/folderSelect.js"></script>
<script src="/js/hamburger.js"></script>

</html>